{
  "$defs": {
    "BoundedText": {
      "additionalProperties": false,
      "description": "Text retained for judging, with its source and truncation facts.",
      "properties": {
        "source": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "text": {
          "maxLength": 6000,
          "title": "Text",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "omitted_chars": {
          "minimum": 0,
          "title": "Omitted Chars",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "text",
        "truncated",
        "omitted_chars"
      ],
      "title": "BoundedText",
      "type": "object"
    },
    "EffectiveConfiguration": {
      "additionalProperties": false,
      "description": "A fully resolved profile/provider/model/effort/output selection.",
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "output_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Limit"
        }
      },
      "required": [
        "profile_id",
        "provider",
        "model"
      ],
      "title": "EffectiveConfiguration",
      "type": "object"
    },
    "EventKind": {
      "description": "The caller event that triggered routing.",
      "enum": [
        "new_user_turn",
        "tool_continuation",
        "application_failed"
      ],
      "title": "EventKind",
      "type": "string"
    },
    "ProfileAvailability": {
      "additionalProperties": false,
      "description": "Caller-reported availability and factual control support for a profile.\n\n``reasoning_efforts``, ``max_output_tokens``, ``context_limit``, and\n``measured_input_tokens`` are None when the caller does not know the fact.\n``measured_input_tokens`` is a measurement for this profile only and must\nnot be copied from a different model.",
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "capabilities": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "reasoning_efforts": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Efforts"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "context_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Limit"
        },
        "measured_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Input Tokens"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "ProfileAvailability",
      "type": "object"
    },
    "TaskState": {
      "additionalProperties": false,
      "description": "Bounded, harness-neutral task content supplied to a judge.\n\nText budgets are enforced per category, retained record counts and source\nlabels have fixed caps, and the serialized state must fit\n``MAX_STATE_BYTES``. The category text sums and the serialized byte cap\nare Python-side checks that standard JSON Schema cannot express.\nMeasured counts (``message_count``, ``input_bytes``, ``tool_count``)\ndescribe the supplied input and are independent of what was retained.",
      "properties": {
        "latest_user": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/BoundedText"
          },
          "maxItems": 32,
          "title": "Instructions",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/BoundedText"
          },
          "maxItems": 64,
          "title": "History",
          "type": "array"
        },
        "tool_excerpts": {
          "items": {
            "$ref": "#/$defs/BoundedText"
          },
          "maxItems": 32,
          "title": "Tool Excerpts",
          "type": "array"
        },
        "instructions_omitted": {
          "minimum": 0,
          "title": "Instructions Omitted",
          "type": "integer"
        },
        "history_omitted": {
          "minimum": 0,
          "title": "History Omitted",
          "type": "integer"
        },
        "tools_omitted": {
          "minimum": 0,
          "title": "Tools Omitted",
          "type": "integer"
        },
        "message_count": {
          "minimum": 0,
          "title": "Message Count",
          "type": "integer"
        },
        "input_bytes": {
          "minimum": 0,
          "title": "Input Bytes",
          "type": "integer"
        },
        "tool_count": {
          "minimum": 0,
          "title": "Tool Count",
          "type": "integer"
        },
        "tool_names": {
          "items": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Tool Names",
          "type": "array"
        },
        "tool_names_omitted": {
          "minimum": 0,
          "title": "Tool Names Omitted",
          "type": "integer"
        }
      },
      "required": [
        "latest_user",
        "instructions",
        "history",
        "tool_excerpts",
        "instructions_omitted",
        "history_omitted",
        "tools_omitted",
        "message_count",
        "input_bytes",
        "tool_count",
        "tool_names",
        "tool_names_omitted"
      ],
      "title": "TaskState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "rejected_effective": {
            "type": "null"
          },
          "recovery_used": {
            "const": false
          },
          "application_failure_code": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "event_kind": {
            "const": "application_failed"
          }
        },
        "required": [
          "event_kind"
        ]
      },
      "then": {
        "properties": {
          "rejected_effective": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "rejected_effective"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_kind": {
            "const": "new_user_turn"
          }
        },
        "required": [
          "event_kind"
        ]
      },
      "then": {
        "properties": {
          "task_state": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "task_state"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_kind": {
            "const": "tool_continuation"
          }
        },
        "required": [
          "event_kind"
        ]
      },
      "then": {
        "properties": {
          "current": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "current"
        ]
      }
    }
  ],
  "description": "A harness-neutral routing request.\n\nCorrelation fields are echoed into the decision. A decision is a proposal\nonly; the caller owns the actually applied configuration. ``None`` token\nor support facts are unknown, not zero.\n\nFor ``application_failed`` events the caller must identify the effective\nselection whose application was rejected (``rejected_effective``) and set\n``recovery_used=True`` when the failed application was already a\ncompatibility-fallback recovery proposed by the core. The core never\nre-proposes ``rejected_effective`` and stops once ``recovery_used``.",
  "properties": {
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "integration_instance_id": {
      "minLength": 1,
      "title": "Integration Instance Id",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "user_turn_id": {
      "minLength": 1,
      "title": "User Turn Id",
      "type": "string"
    },
    "session_revision": {
      "minimum": 0,
      "title": "Session Revision",
      "type": "integer"
    },
    "event_kind": {
      "$ref": "#/$defs/EventKind"
    },
    "task_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "current": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectiveConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "last_applied_decision_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Applied Decision Id"
    },
    "available_profiles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProfileAvailability"
      },
      "title": "Available Profiles",
      "type": "array"
    },
    "required_capabilities": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Capabilities",
      "type": "array",
      "uniqueItems": true
    },
    "required_output_tokens": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Required Output Tokens"
    },
    "safe_to_apply_before_generation": {
      "default": true,
      "title": "Safe To Apply Before Generation",
      "type": "boolean"
    },
    "history_portable": {
      "default": true,
      "title": "History Portable",
      "type": "boolean"
    },
    "application_failure_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Application Failure Code"
    },
    "rejected_effective": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectiveConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recovery_used": {
      "default": false,
      "title": "Recovery Used",
      "type": "boolean"
    }
  },
  "required": [
    "request_id",
    "integration_instance_id",
    "session_id",
    "user_turn_id",
    "session_revision",
    "event_kind"
  ],
  "title": "RoutingRequest",
  "type": "object"
}
