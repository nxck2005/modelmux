{
  "$defs": {
    "EffectiveConfiguration": {
      "additionalProperties": false,
      "description": "A fully resolved profile/provider/model/effort/output selection.",
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "output_limit": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Limit"
        }
      },
      "required": [
        "profile_id",
        "provider",
        "model"
      ],
      "title": "EffectiveConfiguration",
      "type": "object"
    },
    "JudgeResult": {
      "additionalProperties": false,
      "description": "One judge observation of a task profile.\n\n``model_id`` is the judge model identity when one exists; offline judges\nleave it None. A judge result never names a model to route to.",
      "properties": {
        "profile": {
          "$ref": "#/$defs/TaskProfile"
        },
        "observation_kind": {
          "$ref": "#/$defs/ObservationKind"
        },
        "judge_id": {
          "minLength": 1,
          "title": "Judge Id",
          "type": "string"
        },
        "question_version": {
          "default": "task-profile-v1",
          "minLength": 1,
          "title": "Question Version",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgeUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "profile",
        "observation_kind",
        "judge_id"
      ],
      "title": "JudgeResult",
      "type": "object"
    },
    "JudgeUsage": {
      "additionalProperties": false,
      "description": "Token usage reported by a judge. Unknown values are None.",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        }
      },
      "title": "JudgeUsage",
      "type": "object"
    },
    "ObservationKind": {
      "description": "Whether scores are model probabilities or a heuristic.",
      "enum": [
        "probability",
        "heuristic"
      ],
      "title": "ObservationKind",
      "type": "string"
    },
    "ReasonCode": {
      "description": "Why a decision was made.",
      "enum": [
        "rule_match",
        "default_profile",
        "economy_vetoed",
        "retained_current",
        "escalated",
        "compatibility_fallback",
        "judgment_fallback",
        "judge_timeout",
        "judge_unavailable",
        "application_failed",
        "tool_continuation",
        "unsafe_boundary",
        "incompatible_history",
        "candidate_unavailable",
        "no_compatible_profile",
        "invalid_current",
        "incomplete_state",
        "recovery_exhausted"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RouteAction": {
      "description": "The proposed routing action.\n\n``keep`` and ``defer`` leave the current configuration in effect; ``switch``\nreplaces it; ``stop`` means no valid configuration can execute.",
      "enum": [
        "keep",
        "switch",
        "defer",
        "stop"
      ],
      "title": "RouteAction",
      "type": "string"
    },
    "TaskProfile": {
      "additionalProperties": false,
      "description": "Four independent finite scores in [0, 1].\n\nThe scores are not a distribution and do not sum to one.",
      "properties": {
        "reasoning_demand": {
          "ge": 0.0,
          "le": 1.0,
          "title": "Reasoning Demand",
          "type": "number"
        },
        "routine": {
          "ge": 0.0,
          "le": 1.0,
          "title": "Routine",
          "type": "number"
        },
        "underspecified": {
          "ge": 0.0,
          "le": 1.0,
          "title": "Underspecified",
          "type": "number"
        },
        "high_consequence": {
          "ge": 0.0,
          "le": 1.0,
          "title": "High Consequence",
          "type": "number"
        }
      },
      "required": [
        "reasoning_demand",
        "routine",
        "underspecified",
        "high_consequence"
      ],
      "title": "TaskProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "keep"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "target"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "switch"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "target"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "defer"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "type": "null"
          },
          "notify_on_applied": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "stop"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "type": "null"
          },
          "notify_on_applied": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "notify_on_applied": {
            "const": true
          }
        },
        "required": [
          "notify_on_applied"
        ]
      },
      "then": {
        "properties": {
          "action": {
            "const": "switch"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  ],
  "description": "A proposed routing action for the caller to apply.\n\nA decision never claims that a switch happened; only an ApplicationResult\nwith status ``applied`` acknowledges the actual effective configuration.\n``observation`` is the exact judge observation used for this decision and\nis None when no judge was called. ``config_digest`` identifies the routing\nconfiguration that produced the decision.",
  "properties": {
    "decision_id": {
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "user_turn_id": {
      "minLength": 1,
      "title": "User Turn Id",
      "type": "string"
    },
    "session_revision": {
      "minimum": 0,
      "title": "Session Revision",
      "type": "integer"
    },
    "action": {
      "$ref": "#/$defs/RouteAction"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectiveConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "apply_at": {
      "const": "before_next_generation",
      "default": "before_next_generation",
      "title": "Apply At",
      "type": "string"
    },
    "reason_code": {
      "$ref": "#/$defs/ReasonCode"
    },
    "matched_rule_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matched Rule Id"
    },
    "config_digest": {
      "title": "Config Digest",
      "type": "string"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/JudgeResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notify_on_applied": {
      "default": false,
      "title": "Notify On Applied",
      "type": "boolean"
    },
    "elapsed_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elapsed Ms"
    }
  },
  "required": [
    "decision_id",
    "request_id",
    "session_id",
    "user_turn_id",
    "session_revision",
    "action",
    "reason_code",
    "config_digest"
  ],
  "title": "RouteDecision",
  "type": "object"
}
