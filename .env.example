# Copy to .env (ignored by git) and fill in local values.
# Never commit a real credential.
#
# The Jev credential name must be scoped to this project or the judge:
# MODELMUX_JEV_* or JEV_*. The value is sent only to the fixed TypeSafe
# endpoint when the Jev judge is selected.
MODELMUX_JEV_API_KEY=
